10 REM PROYECTO ING INFORMATICA: LAGRANGE + COSENO
20 REM MODELO DE LATENCIA DE RED CON TRES MUESTRAS
30 CLS
40 PRINT "JCC-700 LAGRANGE+COS"
50 X0=0:Y0=20+5*COS(0)
60 X1=10:Y1=20+5*COS(10)
70 X2=20:Y2=20+5*COS(20)
80 X=15
90 L0=(X-X1)*(X-X2)/((X0-X1)*(X0-X2))
100 L1=(X-X0)*(X-X2)/((X1-X0)*(X1-X2))
110 L2=(X-X0)*(X-X1)/((X2-X0)*(X2-X1))
120 Y=L0*Y0+L1*Y1+L2*Y2
130 R=20+5*COS(X)
140 E=ABS(Y-R)
150 PRINT "LAGRANGE=";Y
160 PRINT "COS REAL=";R
170 PRINT "ERROR=";E
180 IF E<.1 THEN PRINT "JCC-700 OK"
190 IF E>=.1 THEN PRINT "REVISAR"
200 END
